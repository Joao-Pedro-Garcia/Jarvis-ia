{
  "name": "jarvis-ia",
  "version": "2.1.0",
  "description": "JARVIS — assistente pessoal inteligente com voz, palmas, memória, Bíblia e notícias",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
