# ===== JARVIS — configuração do servidor =====
# Copie para .env e preencha. NUNCA versione o arquivo .env.

# Porta do servidor (padrão 3000)
PORT=3000
# Endereço de escuta. Use 0.0.0.0 para acessar pelo celular na mesma rede.
HOST=127.0.0.1

# Cérebro (IA conversacional) — Claude API da Anthropic.
# Sem chave, o JARVIS funciona no modo local (comandos, Bíblia, memória,
# cálculos, conversões, notícias sem resumo por IA), mas não conversa livremente.
ANTHROPIC_API_KEY=
# Modelo (padrão claude-opus-5-5)
JARVIS_MODEL=claude-opus-5-5
# Esforço de raciocínio para conversa (low | medium | high). low = mais rápido.
JARVIS_EFFORT=low
# Permitir que o cérebro pesquise na web (ferramenta web_search da Claude API) para perguntas atuais
JARVIS_WEB_SEARCH=1

# Fuso horário usado para "leitura de hoje", horário e datas
JARVIS_TIMEZONE=America/Araguaina

# HTTPS (necessário para usar o microfone pelo celular via rede local)
# HTTPS_KEY=./certs/key.pem
# HTTPS_CERT=./certs/cert.pem

# Token de acesso opcional: se definido, a interface pede o token uma vez
# (útil quando HOST=0.0.0.0). Protege a API contra outros dispositivos da rede.
# JARVIS_ACCESS_TOKEN=

# ===== CASA (opcional) — Home Assistant =====
# HOME_ASSISTANT_URL=http://homeassistant.local:8123
# HOME_ASSISTANT_TOKEN=

# ===== Fontes de dados (opcional, já possuem padrão) =====
# BIBLE_SOURCE_URL=https://raw.githubusercontent.com/thiagobodruk/biblia/master/json/acf.json
# FUEL_GASOLINE_CSV=https://www.gov.br/anp/pt-br/centrais-de-conteudo/dados-abertos/arquivos/shpc/qus/ultimas-4-semanas-gasolina-etanol.csv
# FUEL_DIESEL_CSV=https://www.gov.br/anp/pt-br/centrais-de-conteudo/dados-abertos/arquivos/shpc/qus/ultimas-4-semanas-diesel-gnv.csv
