# =====================================================================
#  JARVIS — configuração do servidor
#  Copie para .env (cp .env.example .env) e preencha. NUNCA versione o .env.
#  Nenhuma variável é obrigatória: sem nada, o JARVIS roda no modo local.
# =====================================================================

# ---------- Servidor ----------
# Porta HTTP/HTTPS.
PORT=3000
# 127.0.0.1 = só este computador. 0.0.0.0 = acessível pelo celular na mesma rede
# (nesse caso use HTTPS e JARVIS_ACCESS_TOKEN).
HOST=127.0.0.1
# Fuso horário para "leitura de hoje", lembretes e horário falado.
JARVIS_TIMEZONE=America/Araguaina

# ---------- IA (conversa livre) — GRATUITA por padrão ----------
# Provedor: auto | local | ollama | none | anthropic | openai
#   auto (padrão) → procura uma IA LOCAL e GRATUITA neste computador:
#                   Ollama (porta 11434), LM Studio (1234) ou llama.cpp (8080).
#                   Sem chave, sem cartão, sem assinatura. Se não achar nenhuma,
#                   o JARVIS usa o MODO LOCAL INTELIGENTE (comandos, cálculos,
#                   memória, Bíblia, conversa básica) — nada deixa de funcionar.
#   none          → desliga a IA (só modo local inteligente)
#   anthropic / openai → serviços ONLINE OPCIONAIS (exigem chave e podem ter custo).
#                   Não são necessários para nada no JARVIS.
#
# Como ter IA local grátis (recomendado):
#   1) Instale o Ollama: https://ollama.com/download (Windows, macOS, Linux)
#   2) No terminal: ollama pull llama3.2:3b   (≈2 GB; roda em PC comum, sem placa de vídeo)
#   3) Deixe o Ollama aberto e reinicie o JARVIS: o diagnóstico mostra "IA LOCAL".
AI_PROVIDER=auto
# Modelo preferido (opcional). Vazio = o primeiro modelo de conversa instalado.
AI_MODEL=
# Endereço de um servidor local diferente (opcional), ex.: http://192.168.0.10:11434
AI_BASE_URL=
# Só para provedores online opcionais (anthropic/openai). Fica SÓ no servidor.
AI_API_KEY=
# Esforço de raciocínio (apenas anthropic): low (rápido) | medium | high
JARVIS_EFFORT=low
# 0 desliga a pesquisa web da IA (apenas anthropic)
JARVIS_WEB_SEARCH=1
# Compatibilidade com a versão 1 (equivale a AI_PROVIDER=anthropic + AI_API_KEY):
# ANTHROPIC_API_KEY=

# ---------- Segurança ----------
# Token de acesso: se definido, a interface pede o token uma vez. Recomendado com HOST=0.0.0.0.
JARVIS_ACCESS_TOKEN=
# Chave (64 caracteres hexadecimais) para criptografar memórias sensíveis (AES-256-GCM).
# Se vazia, uma chave é gerada em data/.secret.key (permissão 0600).
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JARVIS_SECRET_KEY=

# ---------- HTTPS (necessário para o microfone no celular) ----------
# HTTPS_KEY=./certs/key.pem
# HTTPS_CERT=./certs/cert.pem

# ---------- Casa (opcional) — Home Assistant ----------
# HOME_ASSISTANT_URL=http://homeassistant.local:8123
# HOME_ASSISTANT_TOKEN=

# ---------- Fontes de dados (opcional; já possuem padrão) ----------
# BIBLE_SOURCE_URL=https://raw.githubusercontent.com/thiagobodruk/biblia/master/json/acf.json
# FUEL_GASOLINE_CSV=https://www.gov.br/anp/pt-br/centrais-de-conteudo/dados-abertos/arquivos/shpc/qus/ultimas-4-semanas-gasolina-etanol.csv
# FUEL_DIESEL_CSV=https://www.gov.br/anp/pt-br/centrais-de-conteudo/dados-abertos/arquivos/shpc/qus/ultimas-4-semanas-diesel-gnv.csv

# ---------- Diagnóstico ----------
# JARVIS_DEBUG=1              # logs detalhados no terminal
# JARVIS_LOG_TO_FILE=0        # não gravar data/logs/jarvis.log
# JARVIS_REMINDER_INTERVAL_MS=20000  # frequência de verificação de lembretes
# JARVIS_LOG_CONSOLE=0        # não mostrar avisos/erros no terminal
# JARVIS_DATA_DIR=./data      # pasta dos dados locais (progresso, memória, tarefas…)
